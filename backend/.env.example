# EL Backend Environment Configuration
EL_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# AI Provider: "ollama" or "cloud" (OpenAI / Gemini / Anthropic compatible)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional Cloud LLM Keys (if not using local Ollama)
CLOUD_API_KEY=
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=gpt-4o-mini

# Database (Default: SQLite for local zero-cost setup)
DATABASE_URL=sqlite+aiosqlite:///./el_database.sqlite

# Security & Workspace Defaults
WORKSPACE_ROOT=d:\El\workspace
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SAFE_COMMANDS_MODE=true
